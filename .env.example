# Optional: protect the API with a shared secret. Clients send it as
#   X-API-Key: <value>          or          Authorization: Bearer <value>
# Leave empty to run the API open.
API_KEY=

# Optional: pin a pre-minted upstream identity. If unset the service mints its
# own keys on first use - no browser, no login, no API key required.
PERCHANCE_USER_KEY=
PERCHANCE_BROWSER_ID=

# How many upstream identities to keep. Also the max parallel generations,
# because Perchance only allows one in-flight generation per key.
KEY_POOL_SIZE=3

# Generation limits
MAX_COUNT=8
MAX_PROMPT_CHARS=2500
DEFAULT_STYLE=No style
DEFAULT_SHAPE=square
DEFAULT_GUIDANCE_SCALE=7
GENERATE_DEADLINE=240
UPSTREAM_TIMEOUT=120

# Serving
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=*
EXPOSE_DOCS=true
ENABLE_MCP=true
LOG_LEVEL=info
PORT=8080
